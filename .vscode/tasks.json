{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lucid (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-debug",
                "--config",
                "Debug",
                "--target",
                "lucid"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        }
    ]
}
