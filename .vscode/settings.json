{
    "search.exclude": {
        "build": true,
        "build-vs": true
    },
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build-debug"
    ],
    "cmake.debugConfig": {
        "type": "cppvsdbg",
        "cwd": "${workspaceFolder}",
        "environment": [
            {
                "name": "PATH",
                "value": "${workspaceFolder}/dependencies/bin;${env:PATH}"
            }
        ]
    }
}